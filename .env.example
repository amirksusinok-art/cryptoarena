# ==========================================
# CryptoArena Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Environment: 'development' | 'production'
NODE_ENV=development

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bot Operation Mode: 'polling' (recommended for local dev) or 'webhook' (for production on Render)
BOT_MODE=polling

# Public URL of the app (set automatically on Render via RENDER_EXTERNAL_URL or enter manually)
# Example: https://cryptoarena-app.onrender.com
APP_URL=http://localhost:3000

# Admin Secret Key (used to access /admin and trigger events, battles, and coin configs)
ADMIN_SECRET_KEY=admin_secret_super_key_2026

# Admin Telegram User IDs (comma-separated IDs that have admin access inside Telegram Mini App)
ADMIN_TELEGRAM_IDS=123456789

# Database Connection URL (PostgreSQL)
# If left empty, CryptoArena will automatically use local SQLite (cryptoarena.db) for 0-config dev!
# On Render, attach a free PostgreSQL database or use Neon/Supabase:
# DATABASE_URL=postgres://user:password@hostname:5432/cryptoarena
DATABASE_URL=

# Default Trading Configuration
DEFAULT_COMMISSION_RATE=0.0010
DEFAULT_MAINTENANCE_MARGIN_RATE=0.0100
STARTING_BALANCE=10000.00
